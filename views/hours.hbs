<div class="page-head">
  <div>
    <h1>Hours and overtime</h1>
    <p class="muted">{{branch.name}} · {{weekLabel}}</p>
  </div>
  {{#if branches}}
  <form method="get" action="/hours" class="inline">
    <input type="hidden" name="week" value="{{week}}">
    <select name="branch" onchange="this.form.submit()" aria-label="Branch">
      {{#each branches}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{name}}</option>{{/each}}
    </select>
  </form>
  {{/if}}
</div>

<div class="week-nav">
  <a class="btn" href="?week={{prevWeek}}{{#if branches}}&branch={{branch.id}}{{/if}}">&larr; Previous week</a>
  <strong class="week-label">{{weekLabel}}</strong>
  <a class="btn" href="?week={{nextWeek}}{{#if branches}}&branch={{branch.id}}{{/if}}">Next week &rarr;</a>
</div>

<section class="card">
  <table class="table" data-testid="hours" data-sortable>
    <thead>
      <tr>
        <th data-sort>Name</th>
        <th data-sort>Position</th>
        <th data-sort class="num">Shifts</th>
        <th data-sort class="num">Hours</th>
        <th data-sort class="num">Overtime (h)</th>
        <th class="num">Rate</th>
        <th data-sort class="num">Overtime pay (₦)</th>
      </tr>
    </thead>
    <tbody>
      {{#each rows}}
      <tr data-staff-id="{{id}}" {{#if hasOvertime}}class="has-overtime"{{/if}}>
        <td class="name">{{name}}</td>
        <td>{{position}}</td>
        <td class="num shifts">{{shifts}}</td>
        <td class="num hours">{{hours}}</td>
        <td class="num overtime">{{overtime}}</td>
        <td class="num rate">{{rate}}</td>
        <td class="num pay">{{overtimePay}}</td>
      </tr>
      {{/each}}
    </tbody>
    <tfoot>
      <tr><th colspan="3">Total</th><td class="num">{{totalHours}}</td><td></td><td></td><td class="num">{{totalOvertimePay}}</td></tr>
    </tfoot>
  </table>
  <p class="muted small">
    Weeks run Monday to Sunday. Overtime is every hour above 40 in the week, paid at 1.5 &times; the hourly rate.
    An overnight shift counts in full in the week it starts. Click a column heading to sort.
  </p>
</section>
